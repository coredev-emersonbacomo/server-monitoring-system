# PUBLIC FILE — this repo is public, so every value here is visible to everyone.
# All secrets below are DUMMY/EMPTY placeholders (dev-only JWT/Reverb/APP_KEY,
# blank SMTP/Cloudinary/Discord). Generate your own for any real use:
#   php artisan key:generate, fresh JWT_SECRET / REVERB_* per machine.
# Put REAL credentials only in the gitignored personal `.env` (never commit it).
# If you fork/clone: regenerate the dummies, keep personal keys in `.env`,
# and never push a private fork's history back here with real keys in it.
# NOTE: git history before 2026-09-09 contained real Cloudinary/Discord/JWT
# secrets — they must be purged (git filter-repo) and ROTATED before going
# public; treat those old values as compromised.
APP_NAME="Server Monitoring System"
APP_ENV=local
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://server-monitoring-system.test
FRONTEND_URL=http://localhost:5173
DOCS_URL=http://localhost:5174
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=server_monitoring
DB_USERNAME=postgres
DB_PASSWORD=00000000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# SESSION_DOMAIN=

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

JWT_SECRET=dev-only-dummy-jwt-secret-replace-in-personal-env!!

# Frontend (Vite client) — every VITE_* var in this file is injected into
# the browser bundle via scripts/entry.js. Backend values (e.g. REVERB_*)
# are mirrored with a VITE_ prefix further below; edit the source, not the mirror.
VITE_APP_NAME="${APP_NAME}"
VITE_DOCS_URL="${DOCS_URL}"

# Reverb
REVERB_APP_ID=964813
REVERB_APP_KEY=qsnksvf86bztxsdzvsws
REVERB_APP_SECRET=dev-only-dummy-reverb-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8081

# Browser mirrors of the REVERB_* source above (see Frontend section).
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Defaults
DEFAULT_CLIENT_BANNER_IMG_UNSPLASH="https://images.unsplash.com/photo-1560179707-f14e90ef3623?fm=jpg&q=60&w=3000&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8M3x8Y29ycG9yYXRlJTIwYnVpbGRpbmd8ZW58MHx8MHx8fDA%3D"
DEFAULT_PROFILE_PICTURE="https://imgs.search.brave.com/qiHmz1d0zC7mZVMpYv076NCRzIT-VJP6ZGSd-3B0aaM/rs:fit:860:0:0:0/g:ce/aHR0cHM6Ly9zdGF0/aWMudmVjdGVlenku/Y29tL3N5c3RlbS9y/ZXNvdXJjZXMvdGh1/bWJuYWlscy8wMjUv/MzM3LzY2OS9zbWFs/bC9kZWZhdWx0LW1h/bGUtYXZhdGFyLXBy/b2ZpbGUtaWNvbi1z/b2NpYWwtbWVkaWEt/Y2hhdHRpbmctb25s/aW5lLXVzZXItZnJl/ZS12ZWN0b3IuanBn"
VITE_DEFAULT_CLIENT_BANNER="${DEFAULT_CLIENT_BANNER_IMG_UNSPLASH}"
VITE_DEFAULT_PROFILE_PICTURE="${DEFAULT_PROFILE_PICTURE}"

ADMIN_USERNAMES=admin
# Seeded Discord alert targets. Empty by default (were real secrets — removed;
# rotate them if still in use). Put real values in personal .env to test alerts.
SEEDED_DISCORD_BOT_TOKEN=
SEEDED_DISCORD_CHANNEL_ID=
SEEDED_DISCORD_ROLE_ID=

# Mute outbound notifications (Discord/email) in dev. Default OFF so staging-like
# environments behave like prod — set MUTE_NOTIFICATION=true in your personal
# gitignored .env to stay quiet locally. NEVER enable real sends accidentally:
# a fresh clone without that override SENDS.
MUTE_NOTIFICATION=false

# Telescope — dev-only request/query inspector. On here; prod stays safe by
# construction (no .env files in prod containers, compose.prod.yaml forces it
# off, code gate requires local) — see README "Environment layers". Set
# TELESCOPE_ENABLED=false in personal .env to opt out locally.
TELESCOPE_ENABLED=true

# Alert visual debugger — backend. Default off; set ALERTS_VISUAL_DEBUGGER=true
# in the local .env (which overrides this file) for solo debugging.
ALERTS_VISUAL_DEBUGGER=false
VITE_ALERTS_VISUAL_DEBUGGER="${ALERTS_VISUAL_DEBUGGER}"

# Ngrok configuration (for pre-production testing via npm run ngrok)
# NGROK_DOMAIN=your-reserved.ngrok-free.dev
NGROK_UPSTREAM=http://127.0.0.1:8000  # For Docker app; override to http://server-monitoring-system.test for Herd

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Storage provider: local or cloudinary (code default is cloudinary).
# Set local in personal .env for offline dev.
UPLOAD_STORAGE_PROVIDER=cloudinary
# Upload credentials intentionally empty here (a real secret used to live
# above - removed; rotate it if still in use). How to get keys: docs site
# "Storage provider setup" (npm run docs). Put real values in personal .env.
