# Caddy reverse proxy for physical-server deploys (compose.prod.yaml).
# Auto-HTTPS via Let's Encrypt. APP_DOMAIN comes from compose environment.
# /app/* → Reverb websockets (Laravel Echo connects here in prod).
# everything else → Laravel app.

{$APP_DOMAIN} {
    handle /app/* {
        reverse_proxy reverb:8081
    }

    handle {
        reverse_proxy app:8000
    }
}
