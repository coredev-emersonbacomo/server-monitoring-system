{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build -w frontend && npm run build -w docs && vite build",
    "start": "node scripts/entry.js prod",
    "dev": "node scripts/entry.js dev",
    "docs": "npm run dev -w docs",
    "host": "node scripts/host.js",
    "noherd": "cross-env VITE_BACKEND_URL=http://127.0.0.1:8000 node scripts/entry.js dev",
    "prod": "node scripts/entry.js prod",
    "setup": "composer install && npm install",
    "setup:docker": "node scripts/setup-docker-env.js",
    "db": "docker compose exec postgres psql -U postgres -d server_monitoring",
    "db:prod": "docker compose -f compose.yaml -f compose.prod.yaml exec postgres psql -U postgres -d server_monitoring",
    "types": "php artisan scramble:clear && php artisan scramble:export --path=frontend/src/api/api.json && node frontend/scripts/patch-schema.js && npm run types -w frontend",
    "test": "php artisan test",
    "test:filter": "php artisan test --filter",
    "test:auth": "php artisan test --filter=AuthTest",
    "test:middleware": "php artisan test --filter=JwtAuthenticateTest",
    "gpush": "scripts\\git\\git-push.bat",
    "pull": "git stash && git pull && git stash apply",
    "resetdb": "php artisan optimize:clear && php artisan migrate:fresh --seed && php artisan system:monitor && npm run loadtestfactory",
    "cleardb": "php artisan migrate:fresh --seed --seeder=UserSeeder",
    "docker:resetdb": "node scripts/reset-db.js",
    "resetalerts": "php artisan tinker --execute=\"App\\NodeConfig\\Models\\NodeConfigState::query()->delete();\"",
    "compileagent:go": "powershell -ExecutionPolicy Bypass -File scripts/build-agent.ps1",
    "compileagent": "npm run compileagent:go",
    "install-redis:windows": "powershell -ExecutionPolicy Bypass -File scripts/install-redis.ps1",
    "install-redis:linux": "bash scripts/install-redis.sh",
    "loadtestfactory": "php artisan tinker --execute=\"require 'database/seeders/load-test-factory.php';\"",
    "tunnel": "node scripts/tunnel.js",
    "ngrok": "node scripts/ngrok.js",
    "ngrok:build": "node scripts/ngrok-build.js",
    "docker": "node scripts/ngrok.js docker",
    "docker:clean": "node scripts/docker-clean.js",
    "ngrok:clean": "node scripts/docker-clean.js"
  },
  "workspaces": [
    "frontend",
    "docs"
  ],
  "devDependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "concurrently": "^9.0.1",
    "cross-env": "^10.1.0",
    "laravel-vite-plugin": "^3.1",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "@tanstack/react-virtual": "^3.14.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.18.0",
    "pagedjs": "^0.4.3"
  }
}
