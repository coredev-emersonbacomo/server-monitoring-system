# Copy to .env.docker and fill in. Used by compose.prod.yaml.
# Dev (`docker compose up`) needs nothing — defaults in compose.yaml work.
# NEVER commit .env.docker (gitignored).

# Public URL of the deployment (no trailing slash)
APP_URL=https://your-domain.com

# Bare domain for Caddy auto-HTTPS (compose.prod.yaml).
APP_DOMAIN=your-domain.com

# Database (compose.prod.yaml postgres service)
DB_DATABASE=server_monitoring
DB_USERNAME=postgres
DB_PASSWORD=change-me-strong-password

# Redis (compose.prod.yaml redis service)
REDIS_PASSWORD=change-me-redis-password

# Reverb (generate: php artisan reverb:install or reuse dev values for testing)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Baked into frontend at image build time (must match public URL)
VITE_REVERB_HOST=your-domain.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
VITE_DOCS_URL=https://your-domain.com/docs

# Laravel
APP_KEY=base64:generate-with-php-artisan-key-generate
JWT_SECRET=

# Mail (Gmail SMTP example)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=

# Services
MUTE_NOTIFICATION=false
TELESCOPE_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
DEFAULT_CLIENT_BANNER_IMG_UNSPLASH=
DEFAULT_PROFILE_PICTURE=
